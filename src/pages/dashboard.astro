---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { ChevronLeft, ChevronRight, Folder, AlertCircle, Box, BookOpen } from 'lucide-react';
---
<DashboardLayout title="Student Dashboard">
  
  <div class="max-w-[1200px] mx-auto pb-12 w-full">
    
    <!-- Banner -->
    <div class="bg-[#2c6fb7] rounded-xl p-10 text-white mb-8 shadow-sm">
      <h1 class="text-[28px] font-bold mb-3 tracking-tight" id="dashboard-greeting">Good morning</h1>
      <p class="text-blue-100/90 text-[16px] max-w-3xl leading-relaxed font-medium">
        Your all-in-one platform for managing your studies and staying updated with university announcements. Explore the features and make the most of your learning experience
      </p>
      <div class="flex gap-2.5 mt-10">
        <div class="h-1 w-10 bg-white rounded-full"></div>
        <div class="h-1 w-10 bg-white/30 rounded-full"></div>
        <div class="h-1 w-10 bg-white/30 rounded-full"></div>
        <div class="h-1 w-10 bg-white/30 rounded-full"></div>
      </div>
    </div>

    <!-- Main 2-column layout -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
      
      <!-- Left Column (Modules, Attendance) -->
      <div class="xl:col-span-8 space-y-8">
        


      </div>

      <!-- Right Column (Alert, Calendar, Lectures) -->
      <div class="xl:col-span-4 flex flex-col gap-6">
        

        <!-- Calendar -->
        <div class="bg-white rounded-xl px-6 py-5 shadow-sm border border-slate-100">
           <div class="flex items-center justify-between mb-4">
             <span id="calendar-month-label" class="text-[13px] font-bold text-slate-800"></span>
           </div>
           <div class="grid grid-cols-7 text-center text-[11px] font-bold text-slate-800 mb-5 tracking-wide">
             <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span class="text-slate-400">Sat</span><span class="text-slate-400">Sun</span>
           </div>
           <div id="calendar-grid" class="grid grid-cols-7 gap-y-6 text-center text-[13px] font-medium text-slate-700">
           </div>
        </div>


        <div class="text-right mt-auto">
           <span class="text-slate-400 text-[11px] font-medium">Version 1.0.0</span>
        </div>

      </div>

    </div>
  </div>
</DashboardLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Dynamic greeting based on time
    const name = localStorage.getItem('student_name');
    const hour = new Date().getHours();
    let greeting = 'Good morning';
    if (hour >= 12 && hour < 17) {
      greeting = 'Good afternoon';
    } else if (hour >= 17) {
      greeting = 'Good evening';
    }
    
    const greetingEl = document.getElementById('dashboard-greeting');
    if (greetingEl) {
      if (name) {
        const parts = name.split(' ');
        const firstName = parts[0];
        greetingEl.textContent = `${greeting}, ${firstName}`;
      } else {
        greetingEl.textContent = greeting;
      }
    }

    // Render the calendar for the actual current month, with today highlighted.
    const today = new Date();
    const monthLabelEl = document.getElementById('calendar-month-label');
    if (monthLabelEl) {
      monthLabelEl.textContent = today.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    }

    const gridEl = document.getElementById('calendar-grid');
    if (gridEl) {
      const year = today.getFullYear();
      const month = today.getMonth();
      const todayDate = today.getDate();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      // JS getDay(): 0=Sun..6=Sat. Convert to a Mon-first index (0=Mon..6=Sun).
      const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;

      let html = '';
      for (let i = 0; i < firstWeekday; i++) {
        html += '<span></span>';
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const weekdayIndex = (firstWeekday + day - 1) % 7;
        const isWeekend = weekdayIndex === 5 || weekdayIndex === 6;
        const isToday = day === todayDate;
        if (isToday) {
          html += `<div class="flex justify-center"><span class="border border-[#2c6fb7] text-[#2c6fb7] rounded-lg w-7 h-7 flex items-center justify-center font-bold">${day}</span></div>`;
        } else {
          html += `<span class="${isWeekend ? 'text-slate-400' : ''}">${day}</span>`;
        }
      }
      gridEl.innerHTML = html;
    }
  });
</script>
